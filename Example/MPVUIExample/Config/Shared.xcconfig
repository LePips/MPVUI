// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = MPVUIExample
PRODUCT_DISPLAY_NAME = MPVUI Example
PRODUCT_BUNDLE_IDENTIFIER = com.lepips.MPVUIExample
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// Use the installed Apple Development identity for physical-device builds.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = TY84JMYEFE

// ==========================================
// Platform Configuration
// ==========================================
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 18.0

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1,2

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/MPVUIExample.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/MPVUIExample.entitlements
