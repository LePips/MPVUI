// Shared configuration for the MPVUI macOS example target.

PRODUCT_NAME = MPVUIExampleMac
PRODUCT_DISPLAY_NAME = MPVUI Example
PRODUCT_BUNDLE_IDENTIFIER = com.lepips.MPVUIExample.macOS
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = TY84JMYEFE
CODE_SIGN_ENTITLEMENTS = Config/MPVUIExampleMac.entitlements
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = YES
ENABLE_OUTGOING_NETWORK_CONNECTIONS = YES
ENABLE_USER_SELECTED_FILES = readonly

SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
MACOSX_DEPLOYMENT_TARGET = 15.0

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = $(PRODUCT_DISPLAY_NAME)
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.video

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
