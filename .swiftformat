--swiftversion 6.3

--assetliterals visual-width
--computedvarattrs prev-line
--complexattributes prev-line
--emptybraces no-space
--funcattributes prev-line
--ifdef no-indent
--importgrouping alpha
--indent 4
--linebreaks lf
--maxwidth 140
--organizationmode type
--organizetypes class,actor,struct,enum,extension
--markcategories false
--groupblanklines false
--typeorder nestedType,beforeMarks,staticProperty,staticPropertyWithBody,classPropertyWithBody,instanceProperty,swiftUIPropertyWrapper,computedProperty,instanceLifecycle,swiftUIProperty,swiftUIMethod,overriddenMethod,staticMethod,classMethod,instanceMethod
--typeblanklines start-only
--semicolons never
--shortoptionals "always"
--storedvarattrs prev-line
--stripunusedargs closure-only
--tabwidth 4
--trailingclosures
--typeattributes prev-line
--wraparguments before-first
--allowpartialwrapping false
--wrapcollections before-first
--wrapconditions after-first
--wrapparameters before-first
--xcodeindentation enabled

--enable blankLinesAroundMark,   \
    blankLinesAtStartOfScope, \
    isEmpty,                \
    leadingDelimiters,      \
    organizeDeclarations,  \
    redundantInit,          \
    redundantLet,           \
    spaceInsideBraces,      \
    spaceInsideBrackets,    \
    spaceInsideComments,    \
    spaceInsideGenerics,    \
    spaceInsideParens,      \
    singlePropertyPerLine,  \
    trailingSpace,          \
    typeSugar,              \
    void,                   \
    wrapEnumCases,          \
    wrapMultilineFunctionChains

--disable andOperator,       \
    docComments,             \
    redundantClosure,       \
    redundantFileprivate,   \
    redundantSelf,          \
    redundantType,          \
    redundantViewBuilder,   \
    strongOutlets,          \
    trailingCommas,         \
    yodaConditions

--header ignore
