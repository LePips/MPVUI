#!/usr/bin/env python3
"""Build and launch the native Swift CLI with the selected Xcode toolchain."""

import fcntl
import hashlib
import json
import os
from pathlib import Path
import platform
import plistlib
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]


def native_prefix():
    """Launch native tools as arm64 even when Python is running under Rosetta."""
    if platform.machine() != "arm64":
        try:
            result = subprocess.run(["/usr/sbin/sysctl", "-n", "hw.optional.arm64"], capture_output=True, text=True)
        except OSError:
            return []
        if result.returncode == 0 and result.stdout.strip() == "1":
            return ["/usr/bin/arch", "-arm64"]
    return []


def xcode_build(developer):
    with (developer.parent / "version.plist").open("rb") as stream:
        return plistlib.load(stream)["ProductBuildVersion"]


def select_developer(expected, override, applications=Path("/Applications")):
    if override:
        selected = Path(override)
    else:
        selected = None
        for developer in sorted(applications.glob("Xcode*.app/Contents/Developer")):
            try:
                if xcode_build(developer) == expected:
                    selected = developer
                    break
            except (OSError, ValueError, KeyError):
                continue
    if selected is None or not os.access(selected / "Toolchains/XcodeDefault.xctoolchain/usr/bin/swift", os.X_OK):
        raise ValueError(f"Xcode {expected} is required; install it or set DEVELOPER_DIR.")
    return selected.resolve()


def cache_key(root, version, build):
    sources = sorted(path for path in (root / "Build/Sources").rglob("*.swift") if path.is_file()) + [root / "Build/Package.swift"]
    inputs = {str(path.relative_to(root)): hashlib.sha256(path.read_bytes()).hexdigest() for path in sources}
    identity = dict(sources=inputs, swift=version, xcode=build)
    return hashlib.sha256(json.dumps(identity, sort_keys=True).encode()).hexdigest()


def build_cli(root, cache, swift, prefix, environment):
    executable = cache / "release/mpvbuild"
    complete = cache / "complete"
    cache.parent.mkdir(parents=True, exist_ok=True)
    # Keep the lock file: unlinking it could give concurrent callers different locks.
    with cache.with_suffix(".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not (complete.is_file() and os.access(executable, os.X_OK)):
            complete.unlink(missing_ok=True)
            package = cache / "package"
            package.mkdir(parents=True, exist_ok=True)
            shutil.copy2(root / "Build/Package.swift", package / "Package.swift")
            for name in ("Sources", "Tests"):
                destination = package / name
                if destination.exists():
                    shutil.rmtree(destination)
                shutil.copytree(root / "Build" / name, destination, symlinks=True)
            subprocess.run(
                prefix + [str(swift), "build", "--package-path", str(package), "--scratch-path", str(cache), "-c", "release"],
                env=environment,
                stdout=sys.stderr,
                stderr=sys.stderr,
                # A surviving compiler must retain the lock if its launcher is killed.
                pass_fds=(lock.fileno(),),
                check=True,
            )
            if not os.access(executable, os.X_OK):
                raise ValueError(f"Swift build did not produce an executable: {executable}")
            complete.touch()
    return executable


def main(argv=None):
    os.umask(0o022)
    arguments = sys.argv[1:] if argv is None else argv
    apple = json.loads((ROOT / "Build/Inputs.lock.json").read_text())["apple"]
    developer = select_developer(apple["toolchain"]["xcode"]["build"], os.environ.get("DEVELOPER_DIR"))
    environment = dict(
        os.environ,
        DEVELOPER_DIR=str(developer),
        LC_ALL="C",
        TZ="UTC",
        ZERO_AR_DATE="1",
        SOURCE_DATE_EPOCH=str(apple["sourceDateEpoch"]),
    )
    prefix = native_prefix()
    swift = developer / "Toolchains/XcodeDefault.xctoolchain/usr/bin/swift"
    version = subprocess.check_output(prefix + [str(swift), "--version"], env=environment, stderr=subprocess.STDOUT, text=True)
    cache = ROOT / ".build/mpvbuild-cli" / cache_key(ROOT, version, xcode_build(developer))
    executable = build_cli(ROOT, cache, swift, prefix, environment)
    environment["MPVBUILD_CODE_ROOT"] = str(cache / "package/Sources/MPVBuildCore")
    command = prefix + [str(executable), "--root", str(ROOT), *arguments]
    os.execve(command[0], command, environment)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        if error.output:
            print(error.output, file=sys.stderr, end="" if error.output.endswith("\n") else "\n")
        print(f"error: Command failed with exit status {error.returncode}: {error.cmd[0]}", file=sys.stderr)
        raise SystemExit(error.returncode if error.returncode > 0 else 128 - error.returncode)
    except (OSError, ValueError, KeyError) as error:
        print(f"error: {error}", file=sys.stderr)
        raise SystemExit(1)
    except KeyboardInterrupt:
        raise SystemExit(130)
