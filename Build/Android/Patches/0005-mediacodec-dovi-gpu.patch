+// MPVUI_DOVI_GPU_BEGIN: exercised by the native metadata regression harness.
+#if CONFIG_HEVC_MEDIACODEC_DECODER
+static AVMediaCodecDeviceContext *mediacodec_dovi_device(AVCodecContext *avctx)
+{
+    if (!avctx->hw_device_ctx)
+        return NULL;
+    AVHWDeviceContext *device = (void *)avctx->hw_device_ctx->data;
+    return device->type == AV_HWDEVICE_TYPE_MEDIACODEC ? device->hwctx : NULL;
+}
+
+static int mediacodec_dovi_surface_available(AVCodecContext *avctx)
+{
+    AVMediaCodecDeviceContext *device = mediacodec_dovi_device(avctx);
+    return device && device->dolby_vision_surface && device->dolby_vision_status &&
+           device->dolby_vision_status(device->dolby_vision_opaque) > 0;
+}
+
+static int mediacodec_gpu_dovi_allowed(const AVDOVIDecoderConfigurationRecord *dv)
+{
+    return dv->dv_profile == 5 &&
+           dv->rpu_present_flag && dv->bl_present_flag && !dv->el_present_flag &&
+           dv->dv_md_compression == AV_DOVI_COMPRESSION_NONE;
+}
+
+static void mediacodec_gpu_dovi_clear(MediaCodecH264DecContext *s)
+{
+    for (unsigned i = 0; i < FF_ARRAY_ELEMS(s->gpu_metadata); i++)
+        av_frame_free(&s->gpu_metadata[i]);
+    ff_dovi_ctx_flush(&s->gpu_dovi_ctx);
+    s->gpu_packet_queued = 0;
+}
+
+/* Snapshot metadata on input, match it by presentation timestamp on output.
+ * A FIFO or a single current RPU assigns the wrong colors after B-frame reorder.
+ * Refuse ambiguous, malformed, dual-layer, or unbounded streams for SW fallback. */
+static int mediacodec_gpu_dovi_queue(AVCodecContext *avctx, MediaCodecH264DecContext *s,
+                                    const AVPacket *packet)
+{
+    H2645Packet split = {0};
+    AVFrame *metadata = NULL;
+    H2645NAL *rpu = NULL;
+    int ret, slot = -1, vcl = 0;
+    size_t conf_size = 0;
+    const uint8_t *conf = av_packet_get_side_data(packet, AV_PKT_DATA_DOVI_CONF, &conf_size);
+    if (conf) {
+        if (conf_size < sizeof(AVDOVIDecoderConfigurationRecord) ||
+            !mediacodec_gpu_dovi_allowed((const void *)conf))
+            return AVERROR_INVALIDDATA;
+        s->gpu_dovi_ctx.cfg = *(const AVDOVIDecoderConfigurationRecord *)conf;
+    }
+    ret = ff_h2645_packet_split(&split, packet->data, packet->size, avctx,
+                               0, AV_CODEC_ID_HEVC, 0);
+    if (ret < 0)
+        goto done;
+    for (int i = 0; i < split.nb_nals; i++) {
+        H2645NAL *nal = &split.nals[i];
+        if (nal->nuh_layer_id) {
+            ret = AVERROR(ENOSYS);
+            goto done;
+        }
+        vcl |= nal->type < 32;
+        if (nal->type == HEVC_NAL_UNSPEC62) {
+            if (rpu || nal->size <= 2 || nal->temporal_id) {
+                ret = AVERROR_INVALIDDATA;
+                goto done;
+            }
+            rpu = nal;
+        }
+    }
+    if (rpu) {
+        ret = ff_dovi_rpu_parse(&s->gpu_dovi_ctx, rpu->data + 2, rpu->size - 2,
+                               AV_EF_CRCCHECK | AV_EF_EXPLODE);
+        if (ret < 0)
+            goto done;
+        int profile = s->gpu_dovi_ctx.cfg.dv_profile;
+        if (!profile)
+            profile = ff_dovi_guess_profile_hevc(&s->gpu_dovi_ctx.header);
+        if (profile != 5 || !s->gpu_dovi_ctx.header.disable_residual_flag) {
+            ret = AVERROR(ENOSYS);
+            goto done;
+        }
+    }
+    if (!vcl || (!s->gpu_dovi_ctx.cfg.dv_profile && !s->gpu_dovi_ctx.mapping)) {
+        ret = 0;
+        goto done;
+    }
+    if (!s->gpu_dovi_ctx.mapping || !s->gpu_dovi_ctx.color || packet->pts == AV_NOPTS_VALUE) {
+        ret = AVERROR_INVALIDDATA;
+        goto done;
+    }
+    int64_t pts = packet->pts;
+    if (avctx->pkt_timebase.num && avctx->pkt_timebase.den) {
+        pts = av_rescale_q(pts, avctx->pkt_timebase, AV_TIME_BASE_Q);
+        pts = av_rescale_q(pts, AV_TIME_BASE_Q, avctx->pkt_timebase);
+    }
+    for (unsigned i = 0; i < FF_ARRAY_ELEMS(s->gpu_metadata); i++) {
+        if (!s->gpu_metadata[i])
+            slot = i;
+        else if (s->gpu_metadata[i]->pts == pts) {
+            ret = AVERROR_INVALIDDATA;
+            goto done;
+        }
+    }
+    if (slot < 0) {
+        ret = AVERROR(ENOBUFS);
+        goto done;
+    }
+    metadata = av_frame_alloc();
+    if (!metadata) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+    metadata->pts = pts;
+    ret = ff_dovi_attach_side_data(&s->gpu_dovi_ctx, metadata);
+    if (ret < 0)
+        goto done;
+    if (rpu) {
+        AVFrameSideData *raw = av_frame_new_side_data(metadata, AV_FRAME_DATA_DOVI_RPU_BUFFER, rpu->raw_size - 2);
+        if (!raw) {
+            ret = AVERROR(ENOMEM);
+            goto done;
+        }
+        memcpy(raw->data, rpu->raw_data + 2, rpu->raw_size - 2);
+    }
+    s->gpu_metadata[slot] = metadata;
+    metadata = NULL;
+    ret = 0;
+done:
+    av_frame_free(&metadata);
+    ff_h2645_packet_uninit(&split);
+    return ret;
+}
+
+static int mediacodec_gpu_dovi_output(MediaCodecH264DecContext *s, AVFrame *frame)
+{
+    if (!s->gpu_dovi_ctx.cfg.dv_profile && !s->gpu_dovi_ctx.mapping)
+        return 0;
+    if (frame->format != AV_PIX_FMT_MEDIACODEC)
+        return AVERROR(ENOSYS);
+    for (unsigned i = 0; i < FF_ARRAY_ELEMS(s->gpu_metadata); i++) {
+        AVFrame *metadata = s->gpu_metadata[i];
+        if (!metadata || metadata->pts != frame->pts)
+            continue;
+        for (int n = 0; n < metadata->nb_side_data; n++) {
+            AVFrameSideData *sd = metadata->side_data[n];
+            AVBufferRef *ref = av_buffer_ref(sd->buf);
+            if (!ref)
+                return AVERROR(ENOMEM);
+            if (!av_frame_new_side_data_from_buf(frame, sd->type, ref)) {
+                av_buffer_unref(&ref);
+                return AVERROR(ENOMEM);
+            }
+        }
+        if (s->source_range != AVCOL_RANGE_UNSPECIFIED)
+            frame->color_range = s->source_range;
+        av_frame_free(&s->gpu_metadata[i]);
+        return 0;
+    }
+    return AVERROR_INVALIDDATA;
+}
+#endif
