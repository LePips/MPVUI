+#if CONFIG_HEVC_MEDIACODEC_DECODER
+    if (ret == 0 && s->gpu_dovi) {
+        ret = mediacodec_gpu_dovi_output(s, frame);
+        if (ret < 0) {
+            av_log(avctx, AV_LOG_ERROR, "Cannot match Dolby Vision metadata to 10-bit output; using software fallback\n");
+            av_frame_unref(frame);
+            s->rejected_dovi = 1;
+        }
+    }
+#endif
+    return ret;
+}
