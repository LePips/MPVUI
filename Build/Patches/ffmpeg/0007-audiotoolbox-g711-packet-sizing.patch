+// Each G.711 byte is one coded sample. An AVPacket can therefore contain
+// many Core Audio packets, with one sample per channel in each packet.
+static int ffat_decode_g711(AVCodecContext *avctx, AVFrame *frame,
+                            int *got_frame_ptr, const AVPacket *pkt)
+{
+    ATDecodeContext *at = avctx->priv_data;
+    const int channels = avctx->ch_layout.nb_channels;
+    const int sample_bytes = av_get_bytes_per_sample(avctx->sample_fmt);
+    const size_t size = (size_t)pkt->size * sample_bytes;
+    UInt32 written;
+    OSStatus status;
+    int ret;
+
+    if (!pkt->size)
+        return 0;
+    if (channels <= 0 || pkt->size % channels || size > UINT32_MAX)
+        return AVERROR_INVALIDDATA;
+
+    av_fast_malloc(&at->decoded_data, &at->decoded_data_capacity, size);
+    if (!at->decoded_data)
+        return AVERROR(ENOMEM);
+
+    written = size;
+    status = AudioConverterConvertBuffer(at->converter, pkt->size, pkt->data,
+                                         &written, at->decoded_data);
+    if (status || written != size) {
+        av_log(avctx, AV_LOG_ERROR, "G.711 decode failed (%i, %u bytes)\n",
+               (int)status, (unsigned)written);
+        return AVERROR_INVALIDDATA;
+    }
+
+    frame->sample_rate = avctx->sample_rate;
+    frame->nb_samples = pkt->size / channels;
+    frame->flags |= AV_FRAME_FLAG_KEY;
+    ret = ff_get_buffer(avctx, frame, 0);
+    if (ret < 0)
+        return ret;
+    ffat_copy_samples(avctx, frame);
+    *got_frame_ptr = 1;
+
+    return pkt->size;
 }
 
