diff --git a/libavformat/rtmpdh.c b/libavformat/rtmpdh.c
--- a/libavformat/rtmpdh.c
+++ b/libavformat/rtmpdh.c
@@ -253,6 +253,7 @@
 {
     FFBigNum k;
     int ret;
+    size_t len;
 
     bn_new(k);
     if (!k)
@@ -262,7 +263,14 @@
         bn_free(k);
         return ret;
     }
-    bn_bn2bin(k, secret_key, secret_key_len);
+    /* RTMPE derives its keys from a fixed-width, big-endian shared value. */
+    len = bn_num_bytes(k);
+    if (len > secret_key_len) {
+        bn_free(k);
+        return AVERROR(EINVAL);
+    }
+    memset(secret_key, 0, secret_key_len - len);
+    bn_bn2bin(k, secret_key + secret_key_len - len, len);
     bn_free(k);
 
     /* return the length of the shared secret key like DH_compute_key */
