Subject: [PATCH] hevc: downlevel duplicate Dolby Vision RPU diagnostics

Source: edde746/MPVKit b8b922ec74b84ac3a496e29e226a3a3e91491045
Authors: cxfksword / MPVKit contributors, Alex Kim, edde746.
Headers/licenses retained; see ../AVFOUNDATION_CREDITS.md.
Inputs:
  FFmpeg/0010-hevc-downlevel-duplicate-dovi-rpu-log.patch (applied)
  FFmpeg/0015-hevc-downlevel-skipped-nal-log.patch (already-in-base)

diff --git a/libavcodec/hevc/hevcdec.c b/libavcodec/hevc/hevcdec.c
index 18e22f697e64269a40d7c97899a1572d45b83a73..a4df8932b7807c3bdd9a8f02b1b0191232201ac9 100644
--- a/libavcodec/hevc/hevcdec.c
+++ b/libavcodec/hevc/hevcdec.c
@@ -3740,7 +3740,7 @@ static int decode_nal_units(HEVCContext *s, const uint8_t *buf, int length)
     if (rpu_nal) {
         if (s->rpu_buf) {
             av_buffer_unref(&s->rpu_buf);
-            av_log(s->avctx, AV_LOG_WARNING, "Multiple Dolby Vision RPUs found in one AU. Skipping previous.\n");
+            av_log(s->avctx, AV_LOG_VERBOSE, "Multiple Dolby Vision RPUs found in one AU. Skipping previous.\n");
         }
 
         s->rpu_buf = av_buffer_alloc(rpu_nal->raw_size - 2);
