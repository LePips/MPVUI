+        s->targeted_system_display_actual_peak_luminance_flag > 1 ||
+        s->mastering_display_actual_peak_luminance_flag > 1 ||
+        !VALID(s->targeted_system_display_maximum_luminance, 1, (1 << 27) - 1))
+        return 0;
+    for (int w = 0; w < s->num_windows; w++) {
