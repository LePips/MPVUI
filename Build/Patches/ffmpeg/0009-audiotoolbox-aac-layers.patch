+static OSStatus ffat_read_format(AVCodecContext *avctx,
+                                 const uint8_t *cookie, UInt32 cookie_size,
+                                 AudioStreamBasicDescription *format)
+{
+    if (avctx->codec_id == AV_CODEC_ID_AAC) {
+        AudioFormatInfo info = {
+            .mASBD = *format,
+            .mMagicCookie = cookie,
+            .mMagicCookieSize = cookie_size,
+        };
+        AudioFormatListItem *formats;
+        UInt32 size, index, index_size = sizeof(index);
+        OSStatus status;
+
+        // FormatInfo returns the AAC core even when the cookie signals SBR or PS.
+        status = AudioFormatGetPropertyInfo(kAudioFormatProperty_FormatList,
+                                            sizeof(info), &info, &size);
+        if (!status && size >= sizeof(*formats)) {
+            formats = av_malloc(size);
+            if (!formats)
+                return AVERROR(ENOMEM);
+            status = AudioFormatGetProperty(kAudioFormatProperty_FormatList,
+                                            sizeof(info), &info, &size, formats);
+            if (!status)
+                status = AudioFormatGetProperty(kAudioFormatProperty_FirstPlayableFormatFromList,
+                                                size, formats, &index_size, &index);
+            if (!status && index < size / sizeof(*formats)) {
+                *format = formats[index].mASBD;
+                av_free(formats);
+                return 0;
+            }
+            av_free(formats);
+        }
+    }
+
+    UInt32 size = sizeof(*format);
+    return AudioFormatGetProperty(kAudioFormatProperty_FormatInfo,
+                                  cookie_size, cookie, &size, format);
+}
