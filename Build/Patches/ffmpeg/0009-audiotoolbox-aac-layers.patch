+static int ffat_aac_set_config(AVCodecContext *avctx, const uint8_t *config, size_t size)
+{
+    ATDecodeContext *at = avctx->priv_data;
+    uint8_t extended[7];
+    unsigned core_index, output_index;
+
+    // aac_adtstoasc supplies the ADTS header's core configuration.
+    // If stream probing detected SBR, retain its output rate and PS signal.
+    if (size == 2 && config[0] >> 3 == AOT_AAC_LC &&
+        (avctx->profile == AV_PROFILE_AAC_HE || avctx->profile == AV_PROFILE_AAC_HE_V2)) {
+        core_index = (AV_RB16(config) >> 7) & 15;
+        for (output_index = 0; output_index < 13; output_index++) {
+            if (ff_mpeg4audio_sample_rates[output_index] == avctx->sample_rate)
+                break;
+        }
+
+        if (core_index < 13 && output_index < 13 &&
+            2 * ff_mpeg4audio_sample_rates[core_index] == avctx->sample_rate) {
+            PutBitContext bits;
+
+            init_put_bits(&bits, extended, sizeof(extended));
+            put_bits(&bits, 16, AV_RB16(config));
+            put_bits(&bits, 11, 0x2B7); // SBR sync extension
+            put_bits(&bits, 5, AOT_SBR);
+            put_bits(&bits, 1, 1);
+            put_bits(&bits, 4, output_index);
+            if (avctx->profile == AV_PROFILE_AAC_HE_V2) {
+                put_bits(&bits, 11, 0x548); // PS sync extension
+                put_bits(&bits, 1, 1);
+            }
+            flush_put_bits(&bits);
+            size = put_bytes_output(&bits);
+            config = extended;
+        }
+    }
+
+    if (size > INT_MAX - AV_INPUT_BUFFER_PADDING_SIZE)
+        return AVERROR_INVALIDDATA;
+    at->extradata = av_mallocz(size + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!at->extradata)
+        return AVERROR(ENOMEM);
+    at->extradata_size = size;
+    memcpy(at->extradata, config, size);
+    return 0;
+}
