diff --git a/player/command.c b/player/command.c
index 96bc06a0b06e7c4eed854d2ce44e0947fce51c99..f9e73be653be6ea84ddb988e980dddde41655f0b 100644
--- a/player/command.c
+++ b/player/command.c
@@ -98,6 +98,7 @@ struct command_ctx {
     int num_warned_deprecated;
 
     bool command_opts_processed;
+    int external_surface_resize_result;
 
     struct overlay *overlays;
     int num_overlays;
@@ -443,6 +444,25 @@ static int mp_property_generic_option(void *ctx, struct m_property *prop,
     return M_PROPERTY_NOT_IMPLEMENTED;
 }
 
+// Return VO external-resize result synchronously through libmpv properties;
+// option bridge drops VOCTRL result.
+static int mp_property_external_surface_size(void *ctx,
+                                             struct m_property *prop,
+                                             int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    if (action != M_PROPERTY_SET)
+        return mp_property_generic_option(ctx, prop, action, arg);
+
+    mpctx->command_ctx->external_surface_resize_result = VO_NOTIMPL;
+    int result = mp_property_generic_option(ctx, prop, action, arg);
+    if (result <= 0)
+        return result;
+
+    return mpctx->command_ctx->external_surface_resize_result > 0
+        ? M_PROPERTY_OK : M_PROPERTY_ERROR;
+}
+
 /// Playback speed (RW)
 static int mp_property_playback_speed(void *ctx, struct m_property *prop,
                                       int action, void *arg)
@@ -4411,6 +4431,7 @@ static const struct m_property mp_properties_base[] = {
     {"idle-active", mp_property_idle},
     {"window-id", mp_property_window_id},
     {"display-swapchain", mp_property_vo_display_swapchain},
+    {"external-surface-size", mp_property_external_surface_size},
 
     {"chapter-list", mp_property_list_chapters},
     {"track-list", mp_property_list_tracks},
@@ -8017,7 +8038,12 @@ void mp_option_run_callback(struct MPContext *mpctx, struct mp_option_callback *
             queue_seek(mpctx, MPSEEK_RELATIVE, 0.0, MPSEEK_EXACT, 0);
     }
 
-    if (opt_ptr == &opts->vo->android_surface_size || opt_ptr == &opts->vo->d3d11_composition_size) {
+    if (opt_ptr == &opts->vo->android_surface_size) {
+        int result = VO_TRUE;
+        if (mpctx->video_out)
+            result = vo_control(mpctx->video_out, VOCTRL_EXTERNAL_RESIZE, NULL);
+        mpctx->command_ctx->external_surface_resize_result = result;
+    } else if (opt_ptr == &opts->vo->d3d11_composition_size) {
         if (mpctx->video_out)
             vo_control(mpctx->video_out, VOCTRL_EXTERNAL_RESIZE, NULL);
     }
