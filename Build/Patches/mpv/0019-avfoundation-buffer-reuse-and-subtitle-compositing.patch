+static CMSampleBufferRef create_osd_image_sample(struct vo *vo,
+                                                CVPixelBufferRef pixbuf,
+                                                int64_t media_pts_ns)
+{
+    // This raster can be smaller than the coded frame. Unlike transformed
+    // video buffers it still uses the coded grid and needs its source PAR.
+    int p_w = vo->params ? vo->params->p_w : 1;
+    int p_h = vo->params ? vo->params->p_h : 1;
+    if (p_w > 0 && p_h > 0 && p_w != p_h) {
+        NSDictionary *par = @{
+            (id)kCVImageBufferPixelAspectRatioHorizontalSpacingKey: @(p_w),
+            (id)kCVImageBufferPixelAspectRatioVerticalSpacingKey: @(p_h),
+        };
+        CVBufferSetAttachment(pixbuf, kCVImageBufferPixelAspectRatioKey,
+            (__bridge CFDictionaryRef)par, kCVAttachmentMode_ShouldPropagate);
+    } else {
+        CVBufferRemoveAttachment(pixbuf, kCVImageBufferPixelAspectRatioKey);
+    }
+    CVBufferSetAttachment(pixbuf, kCVImageBufferAlphaChannelIsOpaque,
+        kCFBooleanFalse, kCVAttachmentMode_ShouldPropagate);
+    CVBufferSetAttachment(pixbuf, kCVImageBufferAlphaChannelModeKey,
+        kCVImageBufferAlphaChannelMode_PremultipliedAlpha, kCVAttachmentMode_ShouldPropagate);
+    CVBufferSetAttachment(pixbuf, kCVImageBufferColorPrimariesKey,
+        kCVImageBufferColorPrimaries_ITU_R_709_2, kCVAttachmentMode_ShouldPropagate);
+    CVBufferSetAttachment(pixbuf, kCVImageBufferTransferFunctionKey,
+        kCVImageBufferTransferFunction_sRGB, kCVAttachmentMode_ShouldPropagate);
+
+    CMSampleTimingInfo info = {
+        .presentationTimeStamp = cm_time_from_ns(media_pts_ns),
+        .duration = kCMTimeInvalid,
+        .decodeTimeStamp = kCMTimeInvalid
+    };
+
+    CMFormatDescriptionRef format = NULL;
+    CMSampleBufferRef buf = NULL;
+    OSStatus err = CMVideoFormatDescriptionCreateForImageBuffer(NULL, pixbuf, &format);
+    if (err == noErr && format)
+        err = CMSampleBufferCreateReadyWithImageBuffer(NULL, pixbuf, format, &info, &buf);
+
+    if (format)
+        CFRelease(format);
+
+    if (err != noErr || !buf) {
+        MP_ERR(vo, "Failed to create OSD sample buffer: %d\n", (int)err);
+        return NULL;
+    }
+
+    return buf;
+}
