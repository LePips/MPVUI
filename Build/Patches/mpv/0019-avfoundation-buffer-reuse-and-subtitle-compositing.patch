+// A renderer can retain its last displayed IOSurface after a removal flush.
+// Replace it with explicit transparent pixels. This transition-only sample
+// uses a tiny surface and can be timed or displayed immediately.
+static CMSampleBufferRef create_transparent_osd_sample(struct vo *vo, int64_t pts_ns)
+{
+    NSDictionary *attrs = @{
+        (id)kCVPixelBufferIOSurfacePropertiesKey: @{},
+    };
+    CVPixelBufferRef pixbuf = NULL;
+    if (CVPixelBufferCreate(kCFAllocatorDefault, 2, 2,
+            kCVPixelFormatType_32BGRA, (__bridge CFDictionaryRef)attrs,
+            &pixbuf) != kCVReturnSuccess || !pixbuf)
+        return NULL;
+    if (CVPixelBufferLockBaseAddress(pixbuf, 0) != kCVReturnSuccess) {
+        CVPixelBufferRelease(pixbuf);
+        return NULL;
+    }
+    void *base = CVPixelBufferGetBaseAddress(pixbuf);
+    if (!base) {
+        CVPixelBufferUnlockBaseAddress(pixbuf, 0);
+        CVPixelBufferRelease(pixbuf);
+        return NULL;
+    }
+    memset(base, 0, CVPixelBufferGetBytesPerRow(pixbuf) * CVPixelBufferGetHeight(pixbuf));
+    CVPixelBufferUnlockBaseAddress(pixbuf, 0);
+    CMSampleBufferRef buf = create_osd_image_sample(vo, pixbuf, pts_ns);
+    CVPixelBufferRelease(pixbuf);
+    return buf;
+}
