+static bool pcm_init_feeding(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    if (p->opt_max_lookahead > 0) {
+        double lookahead = MPMAX(p->opt_max_lookahead, ao->def_buffer);
+#if TARGET_OS_IPHONE
+        // This is a queue capacity, not a timestamp offset. The synchronizer
+        // already owns the device clock and its latency compensation.
+        double latency = AVAudioSession.sharedInstance.outputLatency;
+        if (!isfinite(latency))
+            latency = 0;
+        lookahead = MPMAX(lookahead,
+            MPCLAMP(latency, 0, 10) + PCM_ROUTE_RESERVE_S);
+#endif
+        p->pcm_lookahead_ns = (int64_t)(lookahead * 1e9);
+        MP_VERBOSE(ao, "PCM lookahead bound: %.3f s\n", lookahead);
+    }
+
+    p->feed_timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0,
+                                           p->queue);
+    if (!p->feed_timer) {
+        MP_FATAL(ao, "failed to create PCM feed timer\n");
+        return false;
+    }
+    dispatch_source_set_event_handler(p->feed_timer, ^{
+        pcm_cancel_pending_feed(p);
+        if (p->feed_enabled)
+            pcm_request_media_data(ao);
+    });
+    pcm_cancel_pending_feed(p);
+    // Keep resumed for its lifetime. Releasing a suspended source traps.
+    dispatch_resume(p->feed_timer);
+    return true;
+}
+
+static void pcm_uninit_feeding(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    if (!p->feed_timer)
+        return;
+    dispatch_sync(p->queue, ^{
+        pcm_set_feeding(ao, false);
+        dispatch_source_cancel(p->feed_timer);
+    });
+    dispatch_release(p->feed_timer);
+    p->feed_timer = NULL;
+}
+
+// All pacing state is confined to p->queue. Limit the next read as well as
+// the already queued lead, so even one buffer cannot exceed the bound.
+static int pcm_request_samples(struct ao *ao, int64_t media_time_ns)
+{
+    struct priv *p = ao->priv;
+    int samples = ao->samplerate / 10;
+    if (!p->pcm_lookahead_ns)
+        return samples;
+
+    int64_t now = mp_time_ns();
+    int64_t elapsed = MPCLAMP(now - p->pcm_credit_time_ns, 0,
+                             p->pcm_lookahead_ns);
+    p->pcm_credit_time_ns = now;
+    // Allow 1% device-clock drift. The renderer-lead limit remains exact,
+    // while this independent guard prevents consumption at decode speed.
+    int64_t refill = elapsed + elapsed / 100;
+    p->pcm_credit_ns = MPMIN(p->pcm_lookahead_ns,
+                            p->pcm_credit_ns + refill);
+    int64_t lead = MPMAX(0, p->end_time_av - media_time_ns);
+    int64_t available = MPMIN(p->pcm_credit_ns,
+                              MPMAX(0, p->pcm_lookahead_ns - lead));
+    return MPMIN(samples, available * ao->samplerate / 1000000000);
+}
 
