+static void pcm_start(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    void (^block)(void) = ^{
+        p->end_time_av = -1;
+        p->pcm_credit_ns = p->pcm_lookahead_ns;
+        [p->synchronizer setRate:1];
+        pcm_set_feeding(ao, true);
+    };
+    if (dispatch_get_specific(&avfoundation_queue_key) == p)
+        block();
+    else
+        dispatch_sync(p->queue, block);
+}
+
+static void pcm_stop(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    pcm_set_feeding(ao, false);
+    [p->renderer flush];
+    [p->synchronizer setRate:0];
+}
+
+static void pcm_set_pause(struct ao *ao, bool paused)
+{
+    struct priv *p = ao->priv;
+    void (^block)(void) = ^{
+        pcm_set_feeding(ao, !paused);
+        [p->synchronizer setRate:paused ? 0 : 1];
+    };
+    if (dispatch_get_specific(&avfoundation_queue_key) == p)
+        block();
+    else
+        dispatch_sync(p->queue, block);
 }
 
