diff --git a/player/loadfile.c b/player/loadfile.c
--- a/player/loadfile.c
+++ b/player/loadfile.c
@@ -1824,10 +1824,21 @@
         }
     }
 
-    for (int t = 0; t < STREAM_TYPE_COUNT; t++)
-        for (int n = 0; n < mpctx->num_tracks; n++)
-            if (mpctx->tracks[n]->type == t)
-                reselect_demux_stream(mpctx, mpctx->tracks[n], false);
+    for (int t = 0; t < STREAM_TYPE_COUNT; t++) {
+        for (int n = 0; n < mpctx->num_tracks; n++) {
+            struct track *track = mpctx->tracks[n];
+            if (track->type != t || !track->stream)
+                continue;
+            if (track->demuxer == mpctx->demuxer) {
+                // A refresh seek on initial selection can skip data in raw
+                // formats. Start from the primary demuxer's packet queue.
+                demuxer_select_track(track->demuxer, track->stream,
+                                     MP_NOPTS_VALUE, track->selected);
+            } else {
+                reselect_demux_stream(mpctx, track, false);
+            }
+        }
+    }
 
     update_demuxer_properties(mpctx);
 
