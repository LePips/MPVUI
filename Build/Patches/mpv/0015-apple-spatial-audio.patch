+    if (action == M_PROPERTY_GET)
+        return ao_control(mpctx->ao, AOCONTROL_GET_SPATIAL_STATUS, arg) == CONTROL_OK
+            ? M_PROPERTY_OK : M_PROPERTY_UNAVAILABLE;
