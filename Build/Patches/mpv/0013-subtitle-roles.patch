+                    node_map_add_string(entry, "role",
+                                        order == 0 ? "primary" : "secondary");
                     if (region->webvtt_settings) {
                         node_map_add_string(entry, "format", "webvtt");
                         node_map_add_string(entry, "settings",
@@ -6496,6 +6499,7 @@
