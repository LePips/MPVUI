+        MP_ERR(vo, "MPVUI_NATIVE_VIDEO_UNSUPPORTED: no color space for native CI overlay\n");
+        return nil;
+    }
+    struct avf_overlay_color color = get_overlay_color(vo, videoBuffer);
+    return avf_subtitle_image(sub, cs, &color);
