+        return M_PROPERTY_UNAVAILABLE;
+    struct m_sub_property props[] = {
+        {"pixel-buffer-copies", SUB_PROP_INT64(stats.pixel_buffer_copies)},
+        {"sample-build-count", SUB_PROP_INT64(stats.sample_build_count)},
