+// On tvOS HDMI routes, AVAudioSession.outputLatency reflects the TV's HDMI
+// display latency while video is presented on an independent layer that still
+// traverses the HDMI display pipeline. Subtract it so audio and video align.
+static int64_t avfoundation_hdmi_latency_ns(void)
+{
+#if TARGET_OS_TV
+    @autoreleasepool {
+        AVAudioSession *session = AVAudioSession.sharedInstance;
+        for (AVAudioSessionPortDescription *port in session.currentRoute.outputs) {
+            if ([port.portType isEqualToString:AVAudioSessionPortHDMI]) {
+                double latency = session.outputLatency;
+                if (isfinite(latency) && latency > 0.0)
+                    return llrint(MPCLAMP(latency, 0.0, 10.0) * 1e9);
+                break;
+            }
+        }
+    }
+#endif
+    return 0;
+}
