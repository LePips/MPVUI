+#include "video/hwdec.h"
+#include "sub/osd.h"
+
+#import <CoreMedia/CoreMedia.h>
+#import <AVFoundation/AVFoundation.h>
+#import <CoreGraphics/CoreGraphics.h>
+#import <CoreImage/CoreImage.h>
+#import <QuartzCore/QuartzCore.h>
+#import <Metal/Metal.h>
+#import <TargetConditionals.h>
+
+
+struct avf_render_geometry {
+    int w, h;
+    struct mp_rect src, dst;
+    struct mp_osd_res osd_res;
+};
+
+enum avf_osd_draw_path {
+    AVF_OSD_DRAW_NONE = 0,
+    AVF_OSD_DRAW_DIRECT_LIBASS,
+    AVF_OSD_DRAW_DIRECT_BGRA,
+    AVF_OSD_DRAW_COREGRAPHICS,
+};
+
+// Sample timing modes.
+//
+// Host: frame->pts carries mpv's scheduled display time; host timebase runs
+// at 1.0. Audio-slaved scheduling absorbs clock skew through microsecond
+// frame adjustments; VO accumulates no timing state. Layer cannot pause
+// itself: queued frames may continue for queue-lead-ms.
+//
+// Media: container PTS uses anchored, rate-servoed timebase following mpv.
+// Required for PiP's time/rate UI. Clock-domain error needs rate slewing or
+// visible re-anchor snap (plezy#1776).
+enum avf_presentation_mode {
+    AVF_PRESENTATION_MEDIA = 0,
+    AVF_PRESENTATION_HOST = 1,
+};
+
+struct avfoundation_opts {
+    bool composite_osd;
+    bool pip_composite_osd;
+    int queue_lead_ms;
+    int presentation;
+    int osd_max_height;
+    bool osd_video_res;
+};
+
+// --- avf sync servo core (host-testable; keep freestanding) ---
+// mpv normally follows audio clock; CMTimebase follows CoreMedia host clock.
+// HDMI PLLs, route changes, and temperature shift their skew. Fixed-rate
+// drift accumulates; >=20ms re-anchor snaps repeat, skip, or drop frames
+// (#1776).
+//
+// PI servo retires small errors over AVF_SERVO_HORIZON_NS through invisible
+// microsecond deadline shifts. Integral absorbs constant clock/rate mismatch,
+// avoiding mismatch * horizon residual. Hard-anchor only timestamp breaks,
+// speed changes, or audio-clock steps after route changes.
+
+// Above threshold: hard-anchor. At slew cap, 50ms correction takes >3s
+// visibly out of sync; mpv hard-resyncs at this scale.
+#define AVF_DRIFT_SNAP_NS      MP_TIME_MS_TO_NS(50)
+// Servo time constant: error retirement horizon.
+#define AVF_SERVO_HORIZON_NS   MP_TIME_S_TO_NS(2)
+// Correction cap: +-1.5% of nominal rate.
+#define AVF_SERVO_MAX_OFFSET   0.015
+// Skip updates <100ppm: ~0.2ms steady-state error, less CoreMedia churn.
+#define AVF_SERVO_MIN_DELTA    0.0001
+// Minimum update interval: ~1/10 horizon; throttling stays stable.
+#define AVF_SERVO_UPDATE_NS    MP_TIME_MS_TO_NS(200)
+// Integral constant = 4x horizon: critical damping, poles (s + 1/(2T))^2.
+// Larger absorbs mismatch slower; smaller rings.
+#define AVF_SERVO_INTEGRAL_NS  (4 * AVF_SERVO_HORIZON_NS)
+// Average timestamp quantization over frame time. Denominator: mpv's
+// speed-adjusted frame duration. Host deadlines include audio-clock jitter,
+// stalls, and A/V corrections unrelated to playback speed.
+#define AVF_RATE_WINDOW_NS        MP_TIME_MS_TO_NS(500)
+#define AVF_RATE_MIN              0.05
+#define AVF_RATE_MAX              8.0
+#define AVF_RATE_CHANGE_FRACTION  0.01
+#define AVF_RATE_FAST_FRACTION    0.04
+#define AVF_RATE_FAST_SAMPLES     2
+
+// Compare media deltas with speed-adjusted frame durations; ignore scheduling
+// jitter.
+struct avf_rate_est {
+    int64_t last_media_pts_ns;
+    int64_t last_frame_duration_ns;
+    bool last_sample_valid;
+    // Steady-state drift window.
+    int64_t media_span_ns;
+    int64_t real_span_ns;
+    // Large-change confirmation window.
+    int64_t fast_media_span_ns;
+    int64_t fast_real_span_ns;
+    int fast_sample_count;
+};
+
+// Discard partial windows; keep last-sample pair.
+static void avf_rate_reset_windows(struct avf_rate_est *e)
+{
+    e->media_span_ns = 0;
+    e->real_span_ns = 0;
+    e->fast_media_span_ns = 0;
+    e->fast_real_span_ns = 0;
+    e->fast_sample_count = 0;
+}
+
+static bool avf_rate_sample(struct avf_rate_est *e, int64_t media_pts_ns,
+                            int64_t frame_duration_ns, double current_rate,
+                            double *rate)
+{
+    if (frame_duration_ns <= 0)
+        return false;
+
+    if (!e->last_sample_valid) {
+        e->last_media_pts_ns = media_pts_ns;
+        e->last_frame_duration_ns = frame_duration_ns;
+        e->last_sample_valid = true;
+        return false;
+    }
+
+    int64_t media_delta = media_pts_ns - e->last_media_pts_ns;
+    int64_t previous_duration = e->last_frame_duration_ns;
+
+    if (media_delta == 0)
+        return false;
+
+    e->last_media_pts_ns = media_pts_ns;
+    e->last_frame_duration_ns = frame_duration_ns;
+
+    // Duration step usually means speed change. Discard partial old-rate
+    // window to avoid false intermediate rate; also resets VFR estimation
+    // safely.
+    int64_t duration_gate = MPMAX(MP_TIME_US_TO_NS(250),
+                                  llabs(previous_duration) / 100);
+    if (media_delta < 0 ||
+        llabs(frame_duration_ns - previous_duration) > duration_gate) {
+        avf_rate_reset_windows(e);
+        return false;
+    }
+
+    double instant = (double)media_delta / (double)previous_duration;
+    if (instant < AVF_RATE_MIN || instant > AVF_RATE_MAX) {
+        avf_rate_reset_windows(e);
+        return false;
+    }
+
+    // Large speed changes cannot wait: 2x schedule would drift 0.25s. Require
+    // two consecutive duration samples to reject quantization and single VFR
+    // transitions.
+    if (fabs(instant - current_rate) >
+            AVF_RATE_FAST_FRACTION * current_rate) {
+        if (e->fast_sample_count > 0) {
+            double fast_rate = (double)e->fast_media_span_ns /
+                               (double)e->fast_real_span_ns;
+            if (fabs(instant - fast_rate) >
+                    AVF_RATE_FAST_FRACTION * fast_rate) {
+                e->fast_media_span_ns = 0;
+                e->fast_real_span_ns = 0;
+                e->fast_sample_count = 0;
+            }
+        }
+        e->fast_media_span_ns += media_delta;
+        e->fast_real_span_ns += previous_duration;
+        e->fast_sample_count++;
+        if (e->fast_sample_count >= AVF_RATE_FAST_SAMPLES) {
+            *rate = (double)e->fast_media_span_ns /
+                    (double)e->fast_real_span_ns;
+            avf_rate_reset_windows(e);
+            return *rate >= AVF_RATE_MIN && *rate <= AVF_RATE_MAX;
+        }
+    } else {
+        e->fast_media_span_ns = 0;
+        e->fast_real_span_ns = 0;
+        e->fast_sample_count = 0;
+    }
+
+    e->media_span_ns += media_delta;
+    e->real_span_ns += previous_duration;
+    if (e->real_span_ns < AVF_RATE_WINDOW_NS)
+        return false;
+
+    *rate = (double)e->media_span_ns / (double)e->real_span_ns;
+    e->media_span_ns = 0;
+    e->real_span_ns = 0;
+    return *rate >= AVF_RATE_MIN && *rate <= AVF_RATE_MAX;
+}
+
+// Ignore implausible steps: stalls, first sample.
+#define AVF_SERVO_MAX_DT_NS    MP_TIME_MS_TO_NS(500)
+
+// Frame-error feedback. error_ns = frame media PTS minus projected timebase
+// at presentation; positive means timebase behind. dt_ns = host time since
+// last evaluation. Persist *integral; zero on hard anchor. Return target
+// rate; *snap requests anchor, *update_rate applies rate.
+static double avf_servo_rate(int64_t error_ns, double nominal_rate,
+                             double applied_rate, int64_t now_ns,
+                             int64_t last_update_ns, int64_t dt_ns,
+                             double *integral, bool *snap,
+                             bool *update_rate)
+{
+    *snap = false;
+    *update_rate = false;
+
+    if (llabs(error_ns) > AVF_DRIFT_SNAP_NS) {
+        *snap = true;
+        return nominal_rate;
+    }
+
+    double p_term = (double)error_ns / (double)AVF_SERVO_HORIZON_NS;
+    p_term = MPCLAMP(p_term, -AVF_SERVO_MAX_OFFSET, AVF_SERVO_MAX_OFFSET);
+
+    if (dt_ns > 0 && dt_ns <= AVF_SERVO_MAX_DT_NS) {
+        *integral += p_term * (double)dt_ns / (double)AVF_SERVO_INTEGRAL_NS;
+        *integral = MPCLAMP(*integral, -AVF_SERVO_MAX_OFFSET,
+                            AVF_SERVO_MAX_OFFSET);
+    }
+
+    double offset = MPCLAMP(p_term + *integral, -AVF_SERVO_MAX_OFFSET,
+                            AVF_SERVO_MAX_OFFSET);
+    double desired = nominal_rate * (1.0 + offset);
+
+    if (fabs(desired - applied_rate) <= AVF_SERVO_MIN_DELTA * nominal_rate)
+        return applied_rate;
+    if (last_update_ns && now_ns - last_update_ns < AVF_SERVO_UPDATE_NS)
+        return applied_rate;
+
+    *update_rate = true;
+    return desired;
+}
+// --- end avf sync servo core ---
+
+struct priv {
+    struct mp_hwdec_ctx hwctx;
+    struct m_config_cache *opts_cache;
+    struct avfoundation_opts *opts;
+    // Latch mode at preinit. Ignore runtime changes: switching would reseed
+    // timebase under queued samples.
+    bool presentation_host;
+
+    struct mp_image *next_image;
+    double next_pts;
+    CMTimebaseRef timebase;
+    int64_t next_present_host_ns;
+    int64_t next_media_pts_ns;
+    bool next_media_pts_valid;
+    double next_timebase_rate;
+    bool next_timebase_rate_valid;
+    __strong AVSampleBufferDisplayLayer *displayLayer;
+
+    // Timed AVSampleBufferDisplayLayer OSD/subtitles.
+    __strong AVSampleBufferDisplayLayer *osdLayer;
+    int64_t osd_change_id;
+    int osd_w, osd_h;
+    struct mp_osd_res osd_res;
+    struct avf_render_geometry render_geometry;
+    bool render_geometry_valid;
+    CVPixelBufferPoolRef osdPool;
+    int osd_pool_w, osd_pool_h;
+    bool osd_needs_enqueue;
+
+    // Track dirty rect per IOSurface; recycled pool buffers retain pixels,
+    // with this code as sole writer. Clear touched rows only. CFRetain pins
+    // identity against pointer reuse.
+    struct osd_buf_state {
+        IOSurfaceRef surf;     // CFRetained
+        struct mp_rect dirty;  // last drawn region
+        int64_t last_used_ns;
+    } osd_buf_states[4];
+    int osd_buf_state_count;
+
+    // OSD counters always accumulate; format logs only with -v.
+    struct {
+        int renders, skipped, empty, frames;
+        int64_t total_ns, max_ns;
+        int64_t clear_ns, blend_ns, cg_ns, bounds_ns;
+        int64_t enqueue_ns, video_sample_ns, wait_ns;
+        // OSD lead = sample PTS minus timebase at enqueue. Negative/small
+        // lead signals CPU missed deadline.
+        int enq_count, enq_drops;
+        int64_t lead_sum_ns, lead_min_ns;
+        int64_t last_spike_ns;
+    } perf;
+
+    // Compositing mode.
+    __strong id<MTLDevice> mtlDevice;
+    __strong CIContext *ciContext;
+    CVPixelBufferPoolRef outputPool;
+    int output_pool_w, output_pool_h;
+    OSType output_pool_format;
+    CGImageRef cachedSubtitleImage;
+    CVPixelBufferRef cachedSubtitleBuffer;
+    int subtitle_x0, subtitle_y0, subtitle_x1, subtitle_y1;
+    bool has_subtitle;
+
+    // Software upload.
+    CVPixelBufferPoolRef swUploadPool;
+    int sw_pool_w, sw_pool_h;
+    OSType sw_pool_format;
+
+    // Cache format description; rebuild when dimensions, format, or
+    // attachments change.
+    CMVideoFormatDescriptionRef video_format_desc;
+
+    // Maintenance frame counter.
+    int frame_count;
+    int not_ready_drop_count;
+    int64_t last_not_ready_drop_ns;
+    int64_t last_display_recovery_ns;
+    int64_t last_video_enqueue_ns;
+    int64_t last_media_pts_ns;
+    bool last_media_pts_valid;
+    bool timebase_anchor_valid;
+    bool timebase_paused;
+    bool playback_paused;
+    double timebase_rate;
+    // Applied CMTimebase rate = timebase_rate + avf_servo_rate() drift
+    // correction.
+    double timebase_applied_rate;
+    int64_t last_rate_update_ns;
+    // PI state; zero on hard anchor.
+    double servo_integral;
+    int64_t last_servo_eval_ns;
+    struct avf_rate_est rate_est;
+
+    // Pacing diagnostics, ~5s intervals.
+    int64_t diag_window_start_ns;
+    int diag_wait_count;
+    int64_t diag_wait_total_ns;
+    int diag_drop_count;
+    int diag_anchor_count;
+    int diag_rate_update_count;
+    // Peak absolute scheduling error per window.
+    int64_t diag_drift_peak_ns;
+
+    // OSD callback ran this frame.
+    bool osd_callback_invoked;
+
+    // Previous frame used Core Image geometry; restore layer when zoom
+    // resets.
+    bool applied_geometry_last_frame;
+
+    // Suppress repeated geometry-failure logs.
+    bool geometry_render_failure_logged;
+
+    // Log Dolby Vision geometry refusal once.
+    bool dovi_geometry_skip_logged;
+    bool dovi_unsupported_logged;
+
+    // Log resized-composite rejection once.
+    bool composite_size_mismatch_logged;
+
+};
+
+static void clear_subtitle_cache(struct priv *p);
+static void release_ci_compositor(struct priv *p);
+static const struct m_sub_options avfoundation_conf;
+
+static bool should_composite_into_video(struct priv *p)
+{
+    return true;
+}
+
+static bool should_use_inline_osd_layer(struct priv *p)
+{
+    return false;
+}
+
+// Frame-space OSD: PiP presents samples directly and sizes its window from
+// them. Subtitles have no surrounding window margin.
+static bool should_use_frame_space_osd(struct priv *p)
+{
+    return true;
+}
+
+static bool should_apply_video_geometry(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    struct mp_vo_opts *opts = vo->opts;
+    // Frame space has no window for zoom/pan; geometry rendering would resize
+    // PiP's source samples.
+    if (should_use_frame_space_osd(p))
+        return false;
+    // Core Image handles per-frame geometry only. Panscan/aspect overrides
+    // use sample-buffer/videoGravity path.
+    return opts && (fabsf(opts->zoom) > 0.0001f ||
+                    fabsf(opts->pan_x) > 0.0001f ||
+                    fabsf(opts->pan_y) > 0.0001f ||
+                    fabsf(opts->scale_x - 1.0f) > 0.0001f ||
+                    fabsf(opts->scale_y - 1.0f) > 0.0001f);
+}
+
+static bool is_p010_format(OSType format)
+{
+    return format == kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange ||
+           format == kCVPixelFormatType_420YpCbCr10BiPlanarFullRange;
+}
+
+static bool is_nv12_format(OSType format)
+{
+    return format == kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange ||
+           format == kCVPixelFormatType_420YpCbCr8BiPlanarFullRange;
+}
+
+static bool is_biplanar_yuv_format(OSType format)
+{
+    return is_nv12_format(format) || is_p010_format(format);
+}
+
+static bool is_full_range_yuv_format(OSType format)
+{
+    return format == kCVPixelFormatType_420YpCbCr8BiPlanarFullRange ||
+           format == kCVPixelFormatType_420YpCbCr10BiPlanarFullRange;
+}
+
+// Planar 10/12-bit 4:2:0 from dav1d/FFmpeg AV1/HEVC lacks named IMGFMT_*. Use
+// generic FFmpeg mapping, as vo_drm.c does.
+static int imgfmt_420p10(void)
+{
+    return pixfmt2imgfmt(AV_PIX_FMT_YUV420P10);
+}
+
+static int imgfmt_420p12(void)
+{
+    return pixfmt2imgfmt(AV_PIX_FMT_YUV420P12);
+}
+
+static id<AVQueuedSampleBufferRendering> active_sample_buffer_renderer(
+    AVSampleBufferDisplayLayer *displayLayer)
+{
+    if (!displayLayer)
+        return nil;
+
+    if (@available(iOS 17.0, tvOS 17.0, macOS 14.0, *))
+        return displayLayer.sampleBufferRenderer;
+
+    return displayLayer;
+}
+
+static AVQueuedSampleBufferRenderingStatus sample_buffer_renderer_status(
+    AVSampleBufferDisplayLayer *displayLayer)
+{
+    if (!displayLayer)
+        return AVQueuedSampleBufferRenderingStatusUnknown;
+
+    if (@available(iOS 17.0, tvOS 17.0, macOS 14.0, *))
+        return displayLayer.sampleBufferRenderer.status;
+
+    return displayLayer.status;
+}
+
+static bool sample_buffer_renderer_requires_flush(
+    AVSampleBufferDisplayLayer *displayLayer)
+{
+    if (!displayLayer)
+        return false;
+
+    if (@available(iOS 17.0, tvOS 17.0, macOS 14.0, *))
+        return displayLayer.sampleBufferRenderer.requiresFlushToResumeDecoding;
+
+    if (@available(iOS 14.0, tvOS 14.0, macOS 11.0, *))
+        return displayLayer.requiresFlushToResumeDecoding;
+
+    return false;
+}
+
+static bool sample_buffer_renderer_is_ready(AVSampleBufferDisplayLayer *displayLayer)
+{
+    id<AVQueuedSampleBufferRendering> renderer =
+        active_sample_buffer_renderer(displayLayer);
+    return renderer && renderer.isReadyForMoreMediaData;
+}
+
+static bool media_pts_is_valid(double pts)
+{
+    return pts != MP_NOPTS_VALUE && isfinite(pts);
+}
+
+static int64_t media_pts_to_ns(double pts)
+{
+    return (int64_t)(pts * (double)NSEC_PER_SEC + (pts >= 0 ? 0.5 : -0.5));
+}
+
+static CMTime cm_time_from_ns(int64_t ns)
+{
+    return CMTimeMake(ns, NSEC_PER_SEC);
+}
+
+static int64_t cm_time_to_ns(CMTime time)
+{
+    if (!CMTIME_IS_NUMERIC(time))
+        return 0;
+
+    CMTime converted = CMTimeConvertScale(time, NSEC_PER_SEC,
+                                          kCMTimeRoundingMethod_Default);
+    return converted.value;
+}
+
+// Anchor with immediate CoreMedia source clock. mpv timestamps use
+// mp_time_ns() epoch, not CM host time.
+static CMTime source_time_for_mp_time(struct priv *p, int64_t target_mp_ns)
+{
+    CMClockOrTimebaseRef source = CMTimebaseCopySource(p->timebase);
+    CMTime source_now = source ? CMSyncGetTime(source) : kCMTimeInvalid;
+    if (source)
+        CFRelease(source);
+    if (!CMTIME_IS_NUMERIC(source_now))
+        source_now = CMClockGetTime(CMClockGetHostTimeClock());
+
+    return CMTimeAdd(source_now, cm_time_from_ns(target_mp_ns - mp_time_ns()));
+}
+
+static int64_t current_media_time_ns(struct priv *p)
+{
+    if (p->next_media_pts_valid)
+        return p->next_media_pts_ns;
+    if (p->last_media_pts_valid)
+        return p->last_media_pts_ns;
+    if (p->timebase)
+        return cm_time_to_ns(CMTimebaseGetTime(p->timebase));
+    return 0;
+}
+
+// Video/OSD timestamp units: scheduled mpv display time in host mode;
+// container PTS in media mode.
+static int64_t sample_presentation_pts_ns(struct priv *p)
+{
+    if (p->presentation_host)
+        return p->next_present_host_ns > 0 ? p->next_present_host_ns
+                                           : mp_time_ns();
+    return current_media_time_ns(p);
+}
+
+static void reset_media_timing(struct priv *p)
+{
+    p->next_present_host_ns = 0;
+    p->next_media_pts_ns = 0;
+    p->next_media_pts_valid = false;
+    p->next_timebase_rate = 0.0;
+    p->next_timebase_rate_valid = false;
+    p->last_media_pts_ns = 0;
+    p->last_media_pts_valid = false;
+    p->timebase_anchor_valid = false;
+    p->timebase_paused = false;
+    p->playback_paused = false;
+    // Keep nominal speed across seeks; first new anchor needs persistent
+    // player rate.
+    p->timebase_rate = p->timebase_rate > 0.0 ? p->timebase_rate : 1.0;
+    p->timebase_applied_rate = p->timebase_rate;
+    p->last_rate_update_ns = 0;
+    p->servo_integral = 0.0;
+    p->last_servo_eval_ns = 0;
+    p->rate_est = (struct avf_rate_est){0};
+}
+
+static void update_media_timebase_for_frame(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (!p->timebase || !p->next_media_pts_valid)
+        return;
+
+    int64_t now = mp_time_ns();
+    int64_t present_host_ns = p->next_present_host_ns > 0
+        ? p->next_present_host_ns
+        : now;
+    int64_t media_pts_ns = p->next_media_pts_ns;
+
+    double rate = p->timebase_rate > 0.0 ? p->timebase_rate : 1.0;
+    bool rate_changed = false;
+    if (p->next_timebase_rate_valid && !p->playback_paused &&
+        fabs(p->next_timebase_rate - rate) >
+            AVF_RATE_CHANGE_FRACTION * rate) {
+        MP_VERBOSE(vo, "Playback rate changed from %.6f to %.6f\n",
+                   rate, p->next_timebase_rate);
+        rate = p->next_timebase_rate;
+        rate_changed = true;
+    }
+    if (p->playback_paused)
+        rate = 0.0;
+
+    bool should_anchor = !p->timebase_anchor_valid || p->timebase_paused ||
+        p->playback_paused || rate_changed;
+
+    if (!should_anchor) {
+        double applied = p->timebase_applied_rate > 0.0
+            ? p->timebase_applied_rate
+            : rate;
+        int64_t timebase_ns = cm_time_to_ns(CMTimebaseGetTime(p->timebase));
+        int64_t projected_ns = timebase_ns +
+            (int64_t)((double)(present_host_ns - now) * applied);
+        int64_t error_ns = media_pts_ns - projected_ns;
+
+        if (llabs(error_ns) > p->diag_drift_peak_ns)
+            p->diag_drift_peak_ns = llabs(error_ns);
+
+        int64_t dt_ns = p->last_servo_eval_ns
+            ? now - p->last_servo_eval_ns
+            : 0;
+        p->last_servo_eval_ns = now;
+
+        bool snap = false, update_rate = false;
+        double servo = avf_servo_rate(error_ns, rate, applied, now,
+                                      p->last_rate_update_ns, dt_ns,
+                                      &p->servo_integral,
+                                      &snap, &update_rate);
+        if (snap) {
+            should_anchor = true;
+            MP_VERBOSE(vo, "Timebase %.1f ms off schedule; re-anchoring\n",
+                       error_ns / 1e6);
+            // Keep nominal rate. Scheduling discontinuity says nothing about
+            // speed; frame-duration estimator owns it.
+        } else if (update_rate) {
+            CMTimebaseSetRate(p->timebase, servo);
+            p->timebase_applied_rate = servo;
+            p->last_rate_update_ns = now;
+            p->diag_rate_update_count++;
+        }
+    }
+
+    if (should_anchor) {
+        CMTime source_time = source_time_for_mp_time(p, present_host_ns);
+        OSStatus err = CMTimebaseSetRateAndAnchorTime(
+            p->timebase, rate, cm_time_from_ns(media_pts_ns),
+            source_time);
+        if (err != noErr) {
+            MP_WARN(vo, "Failed to anchor AVFoundation media timebase: %d\n", (int)err);
+        }
+        // Paused effective rate = zero; retain nominal speed for resume/seek
+        // anchor.
+        if (rate > 0.0)
+            p->timebase_rate = rate;
+        p->timebase_applied_rate = rate;
+        p->last_rate_update_ns = now;
+        p->servo_integral = 0.0;
+        p->last_servo_eval_ns = 0;
+        p->timebase_anchor_valid = true;
+        p->timebase_paused = p->playback_paused;
+        p->diag_anchor_count++;
+    }
+
+    p->last_media_pts_ns = media_pts_ns;
+    p->last_media_pts_valid = true;
+}
+
+static void set_media_timebase_paused(struct vo *vo, bool paused)
+{
+    struct priv *p = vo->priv;
+    if (!p->timebase)
+        return;
+    p->playback_paused = paused;
+
+    if (paused) {
+        CMTime media_time = CMTimebaseGetTime(p->timebase);
+        if (!CMTIME_IS_NUMERIC(media_time)) {
+            media_time = cm_time_from_ns(current_media_time_ns(p));
+        }
+        CMTime source_time = source_time_for_mp_time(p, mp_time_ns());
+        OSStatus err = CMTimebaseSetRateAndAnchorTime(
+            p->timebase, 0.0, media_time, source_time);
+        if (err != noErr)
+            MP_WARN(vo, "Failed to pause AVFoundation media timebase: %d\n", (int)err);
+        p->timebase_applied_rate = 0.0;
+        p->timebase_paused = true;
+        return;
+    }
+
+    p->timebase_paused = false;
+    p->timebase_anchor_valid = false;
+}
+
+static void sample_buffer_renderer_flush(AVSampleBufferDisplayLayer *displayLayer,
+                                         bool remove_image)
+{
+    if (!displayLayer)
+        return;
+
+    if (@available(iOS 17.0, tvOS 17.0, macOS 14.0, *)) {
+        AVSampleBufferVideoRenderer *renderer = displayLayer.sampleBufferRenderer;
+        if (remove_image) {
+            [renderer flushWithRemovalOfDisplayedImage:YES completionHandler:NULL];
+        } else {
+            [renderer flush];
+        }
+        return;
+    }
+
+    if (remove_image) {
+        [displayLayer flushAndRemoveImage];
+    } else {
+        [displayLayer flush];
+    }
+}
+
+static void sample_buffer_renderer_enqueue(AVSampleBufferDisplayLayer *displayLayer,
+                                           CMSampleBufferRef buf)
+{
+    id<AVQueuedSampleBufferRendering> renderer =
+        active_sample_buffer_renderer(displayLayer);
+    [renderer enqueueSampleBuffer:buf];
+}
+
+static bool display_layer_needs_recovery(AVSampleBufferDisplayLayer *displayLayer)
+{
+    if (!displayLayer)
+        return false;
+
+    return sample_buffer_renderer_status(displayLayer) ==
+               AVQueuedSampleBufferRenderingStatusFailed ||
+           sample_buffer_renderer_requires_flush(displayLayer);
+}
+
+static void recover_display_layer(struct vo *vo, const char *reason, bool force)
+{
+    struct priv *p = vo->priv;
+    AVSampleBufferDisplayLayer *displayLayer = [p->displayLayer retain];
+    AVSampleBufferDisplayLayer *osdLayer = [p->osdLayer retain];
+
+    if (!displayLayer) {
+        [osdLayer release];
+        return;
+    }
+
+    int64_t now = mp_time_ns();
+    if (!force && p->last_display_recovery_ns &&
+        now - p->last_display_recovery_ns < MP_TIME_MS_TO_NS(500)) {
+        [displayLayer release];
+        [osdLayer release];
+        return;
+    }
+    p->last_display_recovery_ns = now;
+
+    AVQueuedSampleBufferRenderingStatus status =
+        AVQueuedSampleBufferRenderingStatusUnknown;
+    bool requires_flush = false;
+    bool ready = false;
+    int64_t timebase_ns = 0;
+    double timebase_rate = 0.0;
+
+    {
+        status = sample_buffer_renderer_status(displayLayer);
+        requires_flush = sample_buffer_renderer_requires_flush(displayLayer);
+        ready = sample_buffer_renderer_is_ready(displayLayer);
+        if (p->timebase) {
+            timebase_ns = cm_time_to_ns(CMTimebaseGetTime(p->timebase));
+            timebase_rate = CMTimebaseGetRate(p->timebase);
+        }
+
+        sample_buffer_renderer_flush(displayLayer, false);
+        sample_buffer_renderer_flush(osdLayer, false);
+    }
+
+    MP_WARN(vo, "Recovered AVFoundation display layer after %s "
+                "(status=%ld, requiresFlush=%s, ready=%s, "
+                "mediaPts=%.3f, timebase=%.3f, rate=%.3f)\n",
+            reason, (long)status, requires_flush ? "yes" : "no",
+            ready ? "yes" : "no",
+            current_media_time_ns(p) / 1000000000.0,
+            timebase_ns / 1000000000.0, timebase_rate);
+
+    p->not_ready_drop_count = 0;
+    p->last_not_ready_drop_ns = 0;
+    p->last_video_enqueue_ns = 0;
+    p->timebase_anchor_valid = false;
+    p->timebase_paused = p->playback_paused;
+    p->osd_change_id = 0;
+    p->osd_needs_enqueue = false;
+
+    [displayLayer release];
+    [osdLayer release];
+}
+
+static void record_not_ready_drop(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    int64_t now = mp_time_ns();
+
+    if (p->last_not_ready_drop_ns == 0 ||
+        now - p->last_not_ready_drop_ns > MP_TIME_MS_TO_NS(500))
+        p->not_ready_drop_count = 0;
+
+    p->last_not_ready_drop_ns = now;
+    p->not_ready_drop_count++;
+
+    if (p->not_ready_drop_count >= 3 &&
+        (!p->last_video_enqueue_ns ||
+         now - p->last_video_enqueue_ns >= MP_TIME_MS_TO_NS(500)))
+        recover_display_layer(vo, "repeated not-ready drops", false);
+}
+
+static void update_avfoundation_geometry(struct vo *vo)
+{
+    // Host owns geometry/videoGravity. Never sync-enter main queue from VO:
+    // libmpv teardown may wait here. Frame-space OSD needs no UI reads during
+    // rotation, detach, or PiP resize; sample dimensions stay fixed.
+    vo->dwidth = vo->params ? vo->params->w : 1;
+    vo->dheight = vo->params ? vo->params->h : 1;
+    vo->monitor_par = 1.0;
+}
+
+// --- avf frame-space osd core ---
+// PiP sizes its window from samples. Layer-space subtitles can occupy
+// --sub-use-margins letterbox space; compositing then grows samples and
+// resizes PiP per cue (plezy#2078).
+//
+// Use coded frame grid: collapse margins, make --sub-pos relative to
+// presented frame, preserve composite dimensions, and keep Core Image
+// fallback frame-sized. Squeeze non-square-pixel text to cancel layer
+// stretch, matching osd_res_from_image_params().
+static struct avf_render_geometry avf_frame_space_geometry(int frame_w, int frame_h,
+                                                          int p_w, int p_h)
+{
+    if (frame_w <= 0 || frame_h <= 0)
+        return (struct avf_render_geometry){0};
+
+    struct mp_rect frame = {0, 0, frame_w, frame_h};
+
+    return (struct avf_render_geometry){
+        .w = frame_w,
+        .h = frame_h,
+        .src = frame,
+        .dst = frame,
+        .osd_res = {
+            .w = frame_w,
+            .h = frame_h,
+            .display_par = p_w > 0 && p_h > 0 ? p_h / (double)p_w : 1.0,
+        },
+    };
+}
+
+// Clip cached OSD bounds to video rect; map onto frame grid with one pixel
+// slack per side for inverse compositing. Return false outside video:
+// layer-space cue lies in letterbox margin.
+static bool avf_map_subtitle_rect(struct avf_render_geometry geometry,
+                                  struct mp_rect sub, int sub_w, int sub_h,
+                                  int frame_w, int frame_h,
+                                  struct mp_rect *out)
+{
+    struct mp_rect src = geometry.src;
+    struct mp_rect dst = geometry.dst;
+    int srcW = src.x1 - src.x0;
+    int srcH = src.y1 - src.y0;
+    int dstW = dst.x1 - dst.x0;
+    int dstH = dst.y1 - dst.y0;
+    if (srcW <= 0 || srcH <= 0 || dstW <= 0 || dstH <= 0)
+        return false;
+
+    int frame_x0 = MPCLAMP(src.x0, 0, frame_w);
+    int frame_y0 = MPCLAMP(src.y0, 0, frame_h);
+    int frame_x1 = MPCLAMP(src.x1, 0, frame_w);
+    int frame_y1 = MPCLAMP(src.y1, 0, frame_h);
+    if (frame_x1 <= frame_x0 || frame_y1 <= frame_y0)
+        return false;
+
+    int osd_x0 = MPMAX(sub.x0, MPMAX(dst.x0, 0));
+    int osd_y0 = MPMAX(sub.y0, MPMAX(dst.y0, 0));
+    int osd_x1 = MPMIN(sub.x1, MPMIN(dst.x1, sub_w));
+    int osd_y1 = MPMIN(sub.y1, MPMIN(dst.y1, sub_h));
+    if (osd_x1 <= osd_x0 || osd_y1 <= osd_y0)
+        return false;
+
+    int x0 = src.x0 + (int)(((int64_t)(osd_x0 - dst.x0) * srcW) / dstW) - 1;
+    int y0 = src.y0 + (int)(((int64_t)(osd_y0 - dst.y0) * srcH) / dstH) - 1;
+    int x1 = src.x0 + (int)((((int64_t)(osd_x1 - dst.x0) * srcW) + dstW - 1) / dstW) + 1;
+    int y1 = src.y0 + (int)((((int64_t)(osd_y1 - dst.y0) * srcH) + dstH - 1) / dstH) + 1;
+    x0 = MPCLAMP(x0, frame_x0, frame_x1);
+    y0 = MPCLAMP(y0, frame_y0, frame_y1);
+    x1 = MPCLAMP(x1, frame_x0, frame_x1);
+    y1 = MPCLAMP(y1, frame_y0, frame_y1);
+    if (x1 <= x0 || y1 <= y0)
+        return false;
+
+    *out = (struct mp_rect){x0, y0, x1, y1};
+    return true;
+}
+// --- end avf frame-space osd core ---
+
+static struct avf_render_geometry compute_render_geometry(struct vo *vo,
+                                                          int frame_w,
+                                                          int frame_h)
+{
+    struct priv *p = vo->priv;
+    struct mp_rect src, dst;
+    struct mp_osd_res vo_osd;
+
+    if (frame_w <= 0)
+        frame_w = vo->params ? vo->params->w : 0;
+    if (frame_h <= 0)
+        frame_h = vo->params ? vo->params->h : 0;
+
+    if (should_use_frame_space_osd(p)) {
+        return avf_frame_space_geometry(frame_w, frame_h,
+                                        vo->params ? vo->params->p_w : 1,
+                                        vo->params ? vo->params->p_h : 1);
+    }
+
+    vo_get_src_dst_rects(vo, &src, &dst, &vo_osd);
+
+    if (should_use_inline_osd_layer(p)) {
+        return (struct avf_render_geometry){
+            .w = vo_osd.w,
+            .h = vo_osd.h,
+            .src = src,
+            .dst = dst,
+            .osd_res = vo_osd,
+        };
+    }
+
+    if (frame_w <= 0 || frame_h <= 0 || vo_osd.w <= 0 || vo_osd.h <= 0) {
+        return (struct avf_render_geometry){0};
+    }
+
+    int params_w = vo->params ? vo->params->w : frame_w;
+    int params_h = vo->params ? vo->params->h : frame_h;
+    if (src.x1 <= src.x0 || src.y1 <= src.y0) {
+        src = (struct mp_rect){0, 0, params_w, params_h};
+    }
+
+    return (struct avf_render_geometry){
+        .w = vo_osd.w,
+        .h = vo_osd.h,
+        .src = src,
+        .dst = dst,
+        .osd_res = vo_osd,
+    };
+}
+
+static void invalidate_render_geometry(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    p->render_geometry_valid = false;
+}
+
+static void update_render_geometry(struct vo *vo, int frame_w, int frame_h)
+{
+    struct priv *p = vo->priv;
+
+    if (frame_w <= 0)
+        frame_w = vo->params ? vo->params->w : 0;
+    if (frame_h <= 0)
+        frame_h = vo->params ? vo->params->h : 0;
+
+    update_avfoundation_geometry(vo);
+    p->render_geometry = compute_render_geometry(vo, frame_w, frame_h);
+    p->render_geometry_valid = true;
+}
+
+static struct avf_render_geometry get_render_geometry(struct vo *vo,
+                                                      int frame_w,
+                                                      int frame_h)
+{
+    struct priv *p = vo->priv;
+
+    if (!p->render_geometry_valid || should_apply_video_geometry(vo))
+        update_render_geometry(vo, frame_w, frame_h);
+
+    return p->render_geometry;
+}
+
+// Sync OSD and display layer frames.
+static void sync_osd_layer_frame(struct vo *vo)
+{
+    update_avfoundation_geometry(vo);
+    invalidate_render_geometry(vo);
+}
+
+static void avfoundation_opts_wakeup(void *ctx)
+{
+    vo_wakeup(ctx);
+}
+
+static void update_avfoundation_options(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    if (!p->opts_cache || !p->opts)
+        return;
+
+    bool old_composite_osd = p->opts->composite_osd;
+    bool old_pip_composite_osd = p->opts->pip_composite_osd;
+    int old_queue_lead_ms = p->opts->queue_lead_ms;
+    int old_osd_max_height = p->opts->osd_max_height;
+    bool old_osd_video_res = p->opts->osd_video_res;
+
+    if (!m_config_cache_update(p->opts_cache))
+        return;
+
+    if (old_queue_lead_ms != p->opts->queue_lead_ms)
+        vo_set_queue_params(vo, MP_TIME_MS_TO_NS(p->opts->queue_lead_ms), 1);
+
+    bool composite_changed =
+        old_composite_osd != p->opts->composite_osd ||
+        old_pip_composite_osd != p->opts->pip_composite_osd;
+    bool osd_scale_changed = old_osd_max_height != p->opts->osd_max_height ||
+        old_osd_video_res != p->opts->osd_video_res;
+
+    if (!composite_changed && !osd_scale_changed)
+        return;
+
+    if (composite_changed) {
+        MP_VERBOSE(vo, "OSD compositing updated: composite_osd: %s, "
+                   "pip_composite_osd: %s\n",
+                   p->opts->composite_osd ? "yes" : "no",
+                   p->opts->pip_composite_osd ? "yes" : "no");
+    }
+    if (osd_scale_changed) {
+        MP_VERBOSE(vo, "OSD scaling updated: max_height: %d, video_res: %s\n",
+                   p->opts->osd_max_height,
+                   p->opts->osd_video_res ? "yes" : "no");
+    }
+
+    clear_subtitle_cache(p);
+    if (composite_changed && !should_composite_into_video(p))
+        release_ci_compositor(p);
+    if (p->osdLayer)
+        sample_buffer_renderer_flush(p->osdLayer, true);
+    sync_osd_layer_frame(vo);
+}
+
+// Consume MPVLayerGeometryObserver's pending resize.
+
+
+static void record_deadline_drop(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    record_not_ready_drop(vo);
+    vo_increment_drop_count(vo, 1);
+    p->diag_drop_count++;
+    // Paused redraw rejection has no next frame. Request retained-frame
+    // repaint; VO loop rate-limits retries and handles shutdown between
+    // attempts.
+    if (p->playback_paused && !p->presentation_host)
+        vo->want_redraw = true;
+}
+
+static bool wait_until_ready_for_more_media_data(struct vo *vo, int64_t present_host_ns)
+{
+    struct priv *p = vo->priv;
+    if (display_layer_needs_recovery(p->displayLayer))
+        recover_display_layer(vo, "layer recovery request", false);
+
+    if (sample_buffer_renderer_is_ready(p->displayLayer)) {
+        p->not_ready_drop_count = 0;
+        p->last_not_ready_drop_ns = 0;
+        return true;
+    }
+
+    // Not-ready before deadline means backpressure. queue-lead-ms and high
+    // playback rates can fill renderer early. Wait until near deadline to
+    // match drain rate (#1484).
+    int64_t start = mp_time_ns();
+    // Paused equal-PTS replacement displays immediately; ignore old deadline.
+    // Flush may briefly block readiness. Bound retries so shutdown never
+    // waits on async callbacks.
+    int64_t give_up = p->playback_paused && !p->presentation_host
+        ? start + MP_TIME_MS_TO_NS(20)
+        : present_host_ns > 0
+            ? present_host_ns - MP_TIME_MS_TO_NS(4)
+            : start + MP_TIME_MS_TO_NS(2);
+
+    if (give_up <= start) {
+        MP_VERBOSE(vo, "Display layer not ready %.2f ms before PTS; dropping frame\n",
+                   (present_host_ns - start) / 1000000.0);
+        record_deadline_drop(vo);
+        return false;
+    }
+
+    while (!sample_buffer_renderer_is_ready(p->displayLayer)) {
+        if (mp_time_ns() >= give_up) {
+            MP_VERBOSE(vo, "Display layer not ready at PTS deadline; dropping frame\n");
+            record_deadline_drop(vo);
+            return false;
+        }
+        if (display_layer_needs_recovery(p->displayLayer)) {
+            recover_display_layer(vo, "not-ready wait", false);
+            if (display_layer_needs_recovery(p->displayLayer)) {
+                // Recovery throttled; stop polling failed renderer before
+                // deadline.
+                MP_VERBOSE(vo, "Display layer unrecovered during wait; dropping frame\n");
+                record_deadline_drop(vo);
+                return false;
+            }
+            continue;
+        }
+        mp_sleep_ns(MP_TIME_MS_TO_NS(1));
+    }
+
+    p->not_ready_drop_count = 0;
+    p->last_not_ready_drop_ns = 0;
+    p->diag_wait_count++;
+    p->diag_wait_total_ns += mp_time_ns() - start;
+    return true;
+}
+
+static void report_presentation_diagnostics(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    int64_t now = mp_time_ns();
+
+    if (!p->diag_window_start_ns) {
+        p->diag_window_start_ns = now;
+        return;
+    }
+    if (now - p->diag_window_start_ns < MP_TIME_MS_TO_NS(5000))
+        return;
+
+    if (p->diag_wait_count || p->diag_drop_count || p->diag_anchor_count ||
+        p->diag_rate_update_count || p->diag_drift_peak_ns) {
+        double rate = p->timebase_rate > 0.0 ? p->timebase_rate : 1.0;
+        double offset_ppm =
+            (p->timebase_applied_rate / rate - 1.0) * 1e6;
+        MP_VERBOSE(vo, "Presentation pacing over %.1fs: %d ready-waits "
+                   "(avg %.2f ms), %d deadline drops, %d timebase anchors, "
+                   "%d rate updates (now %+.0f ppm), drift peak %.2f ms\n",
+                   (now - p->diag_window_start_ns) / 1e9,
+                   p->diag_wait_count,
+                   p->diag_wait_count
+                       ? p->diag_wait_total_ns / 1e6 / p->diag_wait_count
+                       : 0.0,
+                   p->diag_drop_count, p->diag_anchor_count,
+                   p->diag_rate_update_count, offset_ppm,
+                   p->diag_drift_peak_ns / 1e6);
+    }
+
+    p->diag_window_start_ns = now;
+    p->diag_wait_count = 0;
+    p->diag_wait_total_ns = 0;
+    p->diag_drop_count = 0;
+    p->diag_anchor_count = 0;
+    p->diag_rate_update_count = 0;
+    p->diag_drift_peak_ns = 0;
+}
