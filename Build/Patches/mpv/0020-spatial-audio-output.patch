diff --git a/audio/out/ao_spatial.m b/audio/out/ao_spatial.m
new file mode 100644
index 0000000..a862222
--- /dev/null
+++ b/audio/out/ao_spatial.m
@@ -0,0 +1,312 @@
+/*
