+ * ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF
+ * OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+#ifndef MPV_CLIENT_API_SPATIAL_AUDIO_H_
+#define MPV_CLIENT_API_SPATIAL_AUDIO_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * The "spatial" audio output hands TrueHD and DTS-HD passthrough to the host
+ * application, which renders it itself, for example as Apple spatial audio
+ * through an AVSampleBufferAudioRenderer. Apple platforms only.
+ *
+ * Use it with --audio-spdif=truehd,dts-hd and --ao=spatial,<pcm output> (or
+ * --ao=spatial, to autoprobe the rest), and
+ * pass the address of a filled-in mpv_spatial_audio_sink, which must outlive
+ * the player, as the int64 option --ao-spatial-sink. The output refuses every
+ * other format, so PCM goes to the next output in the list.
+ *
+ * Load each file with loadfile replace: gapless handoff across files with a
+ * queued next file is not supported.
+ *
+ * mpv keeps its clock on an AVSampleBufferRenderSynchronizer that the output
+ * owns and the host renders into. It holds the clock until is_ready() returns
+ * true, then runs it from the timeline's start, so video waits for the host.
+ */
+
+#define MPV_SPATIAL_AUDIO_SINK_VERSION 2
+
+typedef enum mpv_spatial_audio_codec {
+    MPV_SPATIAL_AUDIO_CODEC_TRUEHD = 1,
+    MPV_SPATIAL_AUDIO_CODEC_DTSHD = 2,
+} mpv_spatial_audio_codec;
+
+/**
+ * Callbacks from the output. They are never called concurrently, except
+ * set_volume, which mpv calls from its core thread. Times are on the
+ * synchronizer's clock, in nanoseconds.
+ */
+typedef struct mpv_spatial_audio_sink {
+    /** MPV_SPATIAL_AUDIO_SINK_VERSION. */
+    int version;
+    void *ctx;
+    /**
+     * Prepares to render `codec` into `synchronizer`, an
+     * AVSampleBufferRenderSynchronizer that stays valid until close(). Return
+     * false to refuse; mpv then decodes the track to PCM.
+     */
+    bool (*open)(void *ctx, mpv_spatial_audio_codec codec, void *synchronizer);
+    /** Starts a new timeline at `time`, dropping everything queued. */
+    void (*begin)(void *ctx, int64_t time);
+    /**
+     * IEC 61937 bursts exactly as mpv's passthrough produces them, split
+     * anywhere, continuing the timeline from begin().
+     */
+    void (*write)(void *ctx, const void *data, size_t size);
+    /** Whether enough audio is queued to start the clock. */
+    bool (*is_ready)(void *ctx);
+    /**
+     * Whether the host failed, for example on a stream it cannot render. The
+     * output then reopens without the host for that codec, so mpv decodes the
+     * track to PCM. Once that PCM output has opened, the next track or audio
+     * reinitialization offers the codec to the host again.
+     */
+    bool (*has_failed)(void *ctx);
+    /** Releases what open() prepared. */
+    void (*close)(void *ctx);
+    /**
+     * Nothing more is written until the next begin(): render everything
+     * written, including what a startup buffer holds back, and become ready.
+     */
+    void (*end)(void *ctx);
+    /**
+     * mpv's software volume as a linear gain: --volume, --volume-gain,
+     * replaygain and --mute together, 0 when muted. mpv cannot scale a
+     * bitstream, so the host applies it to what it renders. Called after
+     * open() and whenever it changes; above 1 is amplification the host may
+     * clamp.
+     */
+    void (*set_volume)(void *ctx, float volume);
+} mpv_spatial_audio_sink;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
